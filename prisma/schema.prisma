// MoveSharp Prisma schema.
// Sourced from the locked data model. Do not drift without an owner sign-off.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  player
  manager
  admin
}

enum MembershipRole {
  player
  manager
}

enum AgeBand {
  U13_U15
  U16_U18
}

enum Position {
  goalkeeper
  right_back
  left_back
  centre_back
  defensive_mid
  central_mid
  attacking_mid
  right_wing
  left_wing
  striker
}

// UK/EU 14 declared allergens.
enum Allergen {
  celery
  cereals_gluten
  crustaceans
  eggs
  fish
  lupin
  milk
  molluscs
  mustard
  peanuts
  sesame
  soybeans
  sulphites
  tree_nuts
}

enum MetricUnit {
  seconds
  meters
  centimeters
  reps
  kilograms
  watts
  custom
}

enum MetricDirection {
  lower_better
  higher_better
}

enum FuelTag {
  before_training
  after_training
  match_day
  pre_match
  hydration
  // Retired: 'school_gap' — no longer used by the app, kept in the enum
  // to avoid a fragile array-cast rebuild. Never write it from code.
  school_gap
}

// A recipe's diet suitability lists every player-diet it fits. A vegan
// dish fits vegan + vegetarian + pescatarian + omnivore; a fish dish
// fits pescatarian + omnivore; a meat dish fits omnivore only. Player
// picks one, we intersect.
enum DietPreference {
  omnivore
  pescatarian
  vegetarian
  vegan
}

// Meal slots for the weekly planner. Kept simple: four familiar
// time-of-day buckets, not the FuelTag rails (which are contextual —
// pre-match, after-training — and a recipe can carry several).
enum MealSlot {
  breakfast
  lunch
  dinner
  snack
}

enum Quality {
  speed
  power
  strength
  agility
  endurance
  robustness
}

// Where the player is training right now — feeds equipment defaults + cue
// selection across the whole app.
enum TrainingContext {
  home
  gym
}

// Exercise taxonomy — different axis from Quality. Quality tags what a
// programme develops; ExerciseCategory groups individual movements.
enum ExerciseCategory {
  speed_acceleration
  plyometric_elastic
  decel_cod
  core_antirotation
  contact_duel_strength
  robustness_resilience
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  role      UserRole @default(player)
  createdAt DateTime @default(now())

  player       Player?
  manager      Manager?
  teamsCreated Team[]           @relation("TeamCreatedBy")
  memberships  TeamMembership[]
}

// Manager (coach) profile — parallel to Player. A User is either a
// player or a manager, never both. The auth helper enforces that.
model Manager {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  name      String
  club      String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Player {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @db.Uuid
  name            String
  dateOfBirth     DateTime        @db.Date
  position        Position?
  club            String?
  avatarId        String?
  // Convenience filter, NOT a substitute for reading ingredients — see locked-decisions.
  allergies       Allergen[]      @default([])
  allergyNote     String?
  dietPreference  DietPreference  @default(omnivore)
  trainingContext TrainingContext @default(home)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics          Metric[]
  entries          MetricEntry[]
  sessions         Session[]
  readiness        ReadinessEntry[]
  customProgrammes Programme[]       @relation("PlayerCustomProgrammes")
  mealPlan         MealPlanEntry[]
  recoveryConsent  RecoveryConsent[]
  joinConsent      JoinConsent[]
}

// Audit trail for the Returning-from-injury disclaimer. Every time a
// player enters an injury-return session and ticks the "cleared by a
// qualified professional" box, we write a row here. Also lets the
// interstitial skip re-prompting within a short window so a mid-
// session refresh doesn't force a re-ack.
model RecoveryConsent {
  id          String   @id @default(uuid()) @db.Uuid
  playerId    String   @db.Uuid
  // Snapshot at the moment of ack — computed from Player.dateOfBirth
  // then, not on read, in case DOB is later corrected.
  isUnder16   Boolean
  // Slug of the specific injury-return session the ack was for. Null
  // if the player ack'd at the section level (currently unused, kept
  // for forward-compat).
  sessionSlug String?
  createdAt   DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

// -----------------------------------------------------------------------------
// Team (schema-ready in v1; feature ships later)
// -----------------------------------------------------------------------------

model Team {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  createdByUserId String   @db.Uuid
  inviteCode      String   @unique
  createdAt       DateTime @default(now())

  // Cascade so a coach who deletes their account removes their teams
  // cleanly — otherwise the FK blocks the delete. Team → memberships
  // and Team → joinConsent already cascade, so player memberships and
  // the join audit history for the deleted teams go with them.
  // Coach-side delete confirmation shows the impact before it runs.
  createdBy   User             @relation("TeamCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  memberships TeamMembership[]
  joinConsent JoinConsent[]
}

// Safeguarding audit trail — written the moment a player redeems a
// team invite. isUnder16 is snapshotted from DOB at the time so a
// later DOB correction can't retroactively strip an ack; parentAck
// is true only when the under-16 friction gate was actually shown.
model JoinConsent {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @db.Uuid
  teamId    String   @db.Uuid
  isUnder16 Boolean
  parentAck Boolean  @default(false)
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@index([teamId, createdAt])
}

model TeamMembership {
  id       String         @id @default(uuid()) @db.Uuid
  userId   String         @db.Uuid
  teamId   String         @db.Uuid
  role     MembershipRole @default(player)
  joinedAt DateTime       @default(now())

  // Per-field consent — a manager only sees data the player opted in on.
  // Shape (defaults all false):
  //   { sessionsVisible: boolean, readinessVisible: boolean, pbsVisible: boolean }
  consent Json @default("{\"sessionsVisible\": false, \"readinessVisible\": false, \"pbsVisible\": false}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

// -----------------------------------------------------------------------------
// Metrics + Sessions
// -----------------------------------------------------------------------------

model Metric {
  id        String          @id @default(uuid()) @db.Uuid
  playerId  String          @db.Uuid
  key       String
  label     String
  unit      MetricUnit
  direction MetricDirection
  isCustom  Boolean         @default(false)
  createdAt DateTime        @default(now())

  player  Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  entries MetricEntry[]

  @@unique([playerId, key])
  @@index([playerId])
}

model MetricEntry {
  id             String   @id @default(uuid()) @db.Uuid
  metricId       String   @db.Uuid
  playerId       String   @db.Uuid
  value          Float
  recordedAt     DateTime
  // Shape (all optional):
  //   { surface?: string, weather?: string, windAssist?: number,
  //     footwear?: string, notes?: string }
  conditions     Json?
  sessionId      String?  @db.Uuid
  isPersonalBest Boolean  @default(false)
  createdAt      DateTime @default(now())

  metric  Metric   @relation(fields: [metricId], references: [id], onDelete: Cascade)
  player  Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([metricId, isPersonalBest])
  @@index([playerId, recordedAt])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  playerId          String    @db.Uuid
  programmeId       String?   @db.Uuid
  sessionTemplateId String?   @db.Uuid
  startedAt         DateTime
  completedAt       DateTime?
  // Shape (each 1-5):
  //   { soreness: number, sleep: number, energy: number, mood: number }
  // Kept separate from the session summary so Team consent can share one without the other.
  readinessBefore   Json?
  feltAfter         Int?
  notes             String?
  // Array of SessionTemplateItem ids the player ticked off. Lightweight logging
  // in v1 — upgraded to per-set data if the depth is warranted later.
  completedItemIds  String[]  @default([])

  player          Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  programme       Programme?       @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  sessionTemplate SessionTemplate? @relation(fields: [sessionTemplateId], references: [id], onDelete: SetNull)
  entries         MetricEntry[]

  @@index([playerId, startedAt])
}

// Daily standalone readiness check-in — decoupled from Session so a player
// can log "how am I feeling" even on rest days. When a session starts it
// snapshots this into Session.readinessBefore for the record.
model ReadinessEntry {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @db.Uuid
  // UTC calendar day, uniqueness enforced by (playerId, recordedOn).
  recordedOn DateTime @db.Date
  soreness   Int
  sleep      Int
  energy     Int
  mood       Int
  notes      String?
  createdAt  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, recordedOn])
  @@index([playerId, recordedOn])
}

// -----------------------------------------------------------------------------
// Programmes / Session templates / Exercises
// Stubs so Session can reference them today; full fields ship in build phase 6-7.
// -----------------------------------------------------------------------------

model Programme {
  id                 String    @id @default(uuid()) @db.Uuid
  slug               String    @unique
  name               String
  description        String?
  // One or two sentences on WHY the programme exists — surfaced above the fold.
  intent             String?
  ageBands           AgeBand[] @default([])
  qualities          Quality[] @default([])
  weeks              Int       @default(6)
  sessionsPerWeek    Int       @default(3)
  equipmentGym       String?
  equipmentHome      String?
  // Shape: [{ week: Int, theme: String, sessions: [{name, focus, gymCue?, homeCue?}] }]
  // Phase 6 preview only; Phase 7 will materialise this into SessionTemplate rows.
  curriculum         Json?
  // Quiz-generated programmes flip isCustom + set createdForPlayerId. Seeded
  // library programmes leave both alone (isCustom=false, no owner).
  isCustom           Boolean   @default(false)
  createdForPlayerId String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdForPlayer Player?           @relation("PlayerCustomProgrammes", fields: [createdForPlayerId], references: [id], onDelete: Cascade)
  templates        SessionTemplate[]
  sessions         Session[]

  @@index([createdForPlayerId])
}

model SessionTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  programmeId String? @db.Uuid
  slug        String  @unique
  name        String
  // Week within the programme (1-based). Optional for stand-alone templates.
  week        Int?
  // Day within the week (1-based).
  day         Int?
  // One-line description surfaced when the session is picked.
  focus       String?
  gymCue      String?
  homeCue     String?

  programme Programme?            @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  items     SessionTemplateItem[]
  sessions  Session[]

  @@unique([programmeId, week, day])
}

model Exercise {
  id                  String            @id @default(uuid()) @db.Uuid
  slug                String            @unique
  name                String
  description         String?
  category            ExerciseCategory  @default(contact_duel_strength)
  // Which training contexts this exercise appears in. Bodyweight movements
  // list both; equipment-specific splits list one (band-row = [home],
  // db-row = [gym]).
  contexts            TrainingContext[] @default([home, gym])
  equipmentGym        String?
  equipmentHome       String?
  // Starting-point prescription surfaced on the library detail page.
  // Programme sessions still carry their own specific prescription on the item.
  defaultPrescription String?
  // Short one-liner shown on the detail page — different from `description`
  // which is longer form.
  coachingCue         String?
  // If set, ticking this item in a session prompts for a PB value that
  // gets saved as a MetricEntry against the metric with this key.
  pbMetricKey         String?
  // MotionSpec drives the procedural Three.js animation — see locked-decisions.
  // In-code today (src/lib/exercise/pilots/) keyed by library slug; this
  // column is reserved for future DB-authored specs.
  motionSpec          Json?

  templateItems SessionTemplateItem[]
}

model SessionTemplateItem {
  id                String @id @default(uuid()) @db.Uuid
  sessionTemplateId String @db.Uuid
  exerciseId        String @db.Uuid
  order             Int
  prescription      Json?

  sessionTemplate SessionTemplate @relation(fields: [sessionTemplateId], references: [id], onDelete: Cascade)
  exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([sessionTemplateId, order])
}

// -----------------------------------------------------------------------------
// Fuel / recipes
// -----------------------------------------------------------------------------

model Recipe {
  id              String           @id @default(uuid()) @db.Uuid
  slug            String           @unique
  name            String
  servings        Int              @default(1)
  // Shape: [{ name: string, quantity: string, note?: string }, ...]
  ingredients     Json
  // Reused enum with Player.allergies powers the hard-exclusion filter.
  allergens       Allergen[]       @default([])
  // Every DietPreference this recipe is suitable for. A vegan dish lists
  // all four; a meat dish lists only omnivore.
  dietSuitability DietPreference[] @default([])
  fuelTags        FuelTag[]        @default([])
  // Per-serving macros — approximate, for at-a-glance fuel check.
  carbsG          Int?
  proteinG        Int?
  instructions    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  plannedIn       MealPlanEntry[]
}

// Weekly meal planner — one row per (player, date, slot). No compound
// unique so a slot can hold zero or one recipe; the server action does
// upsert-by-(playerId,date,slot) manually to enforce one-per-slot.
model MealPlanEntry {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @db.Uuid
  date      DateTime @db.Date
  slot      MealSlot
  recipeId  String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([playerId, date, slot])
  @@index([playerId, date])
}
