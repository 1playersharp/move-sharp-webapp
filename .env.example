# Copy to .env.local and fill in from the Supabase project dashboard.
# .env.local is git-ignored — never commit real secrets.

# Postgres (Supabase → Project Settings → Database → Connection string)
# DATABASE_URL uses the pooled connection (port 6543, ?pgbouncer=true).
# DIRECT_URL is the non-pooled connection (port 5432) — required for `prisma migrate`.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase JS client (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Server-only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Dev bypass: set to 1 to skip auth locally (a fixture player is injected).
# Force-disabled when NODE_ENV=production; safe to leave in .env.local.
MOVESHARP_DEV_BYPASS=0
